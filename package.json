{
  "name": "gitscope-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter=!@gitscope/monorepo run build",
    "test": "pnpm -r --filter=!@gitscope/monorepo run test",
    "typecheck": "pnpm -r --filter=!@gitscope/monorepo run typecheck",
    "lint": "pnpm -r --filter=!@gitscope/monorepo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "dev:api": "pnpm --filter @gitscope/api dev",
    "dev:web": "pnpm --filter @gitscope/web dev"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
